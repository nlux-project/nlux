  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Haventafereel met op de voorgrond rieten manden met verschillende soorten vis, zoals krab en een platvis en gewone vissen. Aan de rechterzijde een donkergroen houten gebouw. Aan het gebouw hangen visnetten, een fuik en er staat een tweetands vork. Aan de linker zijde zitten mannen bij een kampvuur. Boven het vuur hangt een ketel. In het midden van het schilderij zijn boten te zien met vissers. Aan de linkerzijde is een groot schip te zien. Op de achtergrond van het schilderij zijn molens en kerken te zien.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "description"
        }
      ]
    },
