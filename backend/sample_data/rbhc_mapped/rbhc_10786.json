  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Zwartgeverfde ijzeren kijkerbuis (170 cm lang, 24 cm doorsnee) met messing afsluitkap op houten driepoot tafelstatief (azimutaal, met fijnbeweging op beide assen). Hoofdspiegel (21 cm doorsnee) van verzilverd glas, secundaire spiegel ontbreekt. Oculair ontbreekt. Messing zoeker (41 cm lang, 35 mm doorsnee), oculair en objectief ontbreekt.",
      "classified_as": [
        {
