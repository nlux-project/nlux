  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Geheel vernikkeld stalen tang, Amerikaans model. Met gedeeltelijk geruite (reliëf) handvat, 1 van de handgrepen is in een krul omgebogen.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
