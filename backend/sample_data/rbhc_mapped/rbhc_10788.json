  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Houten bankje (h 14, b 39, d 21.5 cm.) gemaakt om valbuishouder (zie oud invnr. L2 eveneens met regnr. 9623) met rechtstandig in te zetten onmogelijk te dateren maar lijkt eerder 20e dan 18e eeuws.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "De bouw- en gebruiksgeschiedenis staat afdoende beschreven in bovengenoemde publicaties. Het instrument is na 1675 meermalen gewijzigd. De verticale cilinder van ca. 2 voet lengte, in messingen bak voor vloeistofafdichting, is origineel; de blaker - oorspronkelijk in een houten bak op gelijk niveau met de uitvoer - is nu gemonteerd op een houten tafeltje van laat 18e eeuwse makelij.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "'Samuel van Muschenbroek Fecit 1675' staat gegraveerd in het werkplaatsteken van de Oosterse Lamp, dat op de messingen bak rond the cilinder is vastgeschroefd."
    }
  ],
