    },
    {
      "type": "LinguisticObject",
      "content": "Gebruikt door Lord Joseph Lister (1827-1912). Deze scalpels stammen waarschijnlijk uit de Edinburgse tijd. Lister was daar van 1869-1877 hoogleraar, maar ze kunnen ook uit de periode 1853-1860 zijn. Ca 1855 hield hij zich veel met oogheelkunde bezig.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Op 5 scalpels : \"YOUNG / EDINR\"\r\nOp 1 scalpel: \"BORTH / WICK\"\r\nEtiket op doosje: \"Lord Lister's scalpels\"  en etiket met \"sir J. Lister, 3550\""
    }
  ],
