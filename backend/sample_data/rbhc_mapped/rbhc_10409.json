  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Messing cirkel van Borda met twee kijkers op een driepoot. De azimut cirkel kan horizontaal gezet worden met drie instellingsschroeven.\r\nDe cirkel heeft een schaalverdeling van 0 tot 360 graden, verdeeld per halve graad.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
