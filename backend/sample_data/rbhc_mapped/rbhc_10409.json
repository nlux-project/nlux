              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Niet geheel compleet.\r\nOude kaart:\r\nDit type instrumenten werd gebruikt voor nauwkeurige geodetische waarnemingen, onder andere triangulatiemetingen.\r\nverder (omschrijving, opschrift, afmetingen, aankoopdatum)",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Op cirkel: \"Lenoir a Paris\"\r\nOp de onderkant van de voet: \"296\" (twee maal)"
