  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Ronde biconvexe lens van grijzig glas met een papieren diafragma, een metalen schaal en een houten opbergring.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "De kromtestralen van de beide zijden bedragen: 1061 cm, 1069 cm De brekingsindex van het glas is: 1,525 De brandpuntafstand is: 1018 cm  De metalen schaal is in de sterrenwacht bijgemaakt.  De lens komt in de lijst (ca. 1720) van Constantijn Huygens Lodewijkszoon voor onder nr. A1.23; in de lijst (ca. 1720) van Jan van Musschenbroek onder nr. 23. Bij de veiling van 1754 kreeg hij nr. 20. Toen is de lens gekocht door Susanna Louise Huygens en bij de veiling in 1786 is de lens gekocht door A.J. Royer.  De handschriften zijn van Constantijn zelf. Volgens een getypte lijst (vermoedelijk uit de sterrenwacht) was er bij deze lens een schutblad, met daarop o.a. het nummer 118. Dat was vermoedelijk het volgnummer van de veiling van 1786.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Diverse lijsten bij V09186 in voorwerparchief",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Op de lens: \"CHuygens 13. Nov. 1683.\"\r\nOp het diafragma: \"13. Nov. 1683. / Ped. 34\"\r\nOp de schaal: \"12\""
    }
