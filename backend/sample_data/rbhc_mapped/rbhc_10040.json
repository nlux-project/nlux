  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "\"Geryk\"-luchtpomp op ijzeren basis met hefboom-zwengel, die ingeklapt kan worden en ondersteund wordt door aparte zuil.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "De datering is gebaseerd op de veronderstelling dat dit nummer Ae2 is uit de school in Deventer. In het inschrijfboek wordt behalve het jaar van aanschaf (1901) alleen vermeld dat het om een Geryk-pomp gaat. Met die naam werd dit type pomp volgens ontwerp van Fleuss bedoeld. De enige andere pomp, die met Ae2 geïdentificeerd zou kunnen worden is nr. 7674. Ook deze berust op een patent van Fleuss, maar is een nogal afwijkend type. Ik heb nergens aanwijzingen gevonden dat dit al in 1901 gemaakt werd. De pomp nr. 7667 heeft sporen van een etiketje, waarop de registratienummer gestaan zou kunnen hebben.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "\"FLEUSS PATENT\"\r\nMADE IN GERMANY\"\r\n\"D.R.P.\"\r\n\"N 9280\""
    }
  ],
