  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Messing sacharimeter (polaristrobometer) op metalen statief met driepoot, inclusief monsterbuis. Op de messing schijf aan het uiteinde van de meter staat links een schaalverdeling in grammen, rechts hoogstwaarschijnlijk in graden. Parallel aan de meter zit een messing buis, gericht op de schaal van de draaischijf. Rechts van de meter zit een draaiwieltje om de grote schijf mee te verdraaien.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Dit type polarimeter werd in 1864 door Wild uitgevonden.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "(gegraveerd) 'Hermann & Pfister/Bern'\r\n(metalen plaatje) '100' Schaalverdeling\r\n(links): 'Gram''400  350...0...350  400''Gram' Schaalverdeling\r\n(rechts): '110  105....0  355  350'"
    }
  ],
