  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Tafeltje met twee armklemmen en twee handgrepen. De beide handgrepen hebben elk een dubbele ketting-en-poelie overbrengen op een verzwaarde hefboom. Losse onderdelen: 2 kussentjes voor over de armklemmen (1,5x10,5x2,5; 1 leer; 1 leer + textiel)",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "De maten zijn opgenomen met het toestel in een opstelling waarin het gebruikt zou kunnen worden.  Bij het toestel werd een gewone stoel gebruikt. Er is dan ook geen bijbehorende stoel bewaard gebleven.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "\"G. ZANDER\" gedeeltelijk weggepoetst uit een messing plaatje\r\n\"31\" op een ketting\r\n\"B / 31\" op een ketting\r\nschaalverdeling 0-10 op verzwaarde hefbomen\r\n2x \"Strekken / Uittrekken\"\r\n2x \"Buigen / Inschuiven\""
    }
  ],
