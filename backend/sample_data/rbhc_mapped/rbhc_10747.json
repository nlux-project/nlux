  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Toestel waarmee de voet doormiddel van een gecombineerde kantel- en draaibeweging een slinger in beweging brengt. Los onderdeel: Leren riempje (57x2) om de schoen aan de voetsteun te bevestigen. Voor bijbehorende stoel: zie opmerkingen",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Bij dit toestel hoort een middelhoge stoel zonder wieltjes (95x53x60), die ingeschreven is (ten onrechte) als onderdeel van nr. 9536. De verstelbare stoel op rails die op sommige foto's (bv K 1032-29) bij dit toestel staat hoort er niet bij.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "\"G. ZANDER\" (ingegoten), schaalverdeling 1-10 op de slinger, schaalverdeling 6-10 op de voetsteun\r\nBij de schakel-hendel: \"Rechter Fuss / Linker Fuss\"\r\nBij de instelling van de stand van de slinger:  \"Widerstand / Rechter Fuss-Pron. / Linker Fuss-Supin.\",\r\n\"Pendel\", \"Rechter / Supin.\", \"Linker / Pron.\", \"Rechter / Pron.\", \"Linker / Supin.\", \"2 1 0 1 2\",\r\n\"Widerstand / Rechter Fuss-Supin. / Linker Fuss-Pron.\""
    }
  ],
