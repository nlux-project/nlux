  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Mahoniehouten onderstel (6 x 45 x 16) Licht (palm?)houten dubbele kegel (16, diameter 8)",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
