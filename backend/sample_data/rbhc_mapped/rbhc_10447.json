  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "Mahoniehouten kistje met twee messing kalibreermaten en een messing hoogtemeter met stalen punten voor het ijken van de dieptes en binnendiameters van grote vochtmaten. Hoogtemeter met bereik 30-500 mm. Kalibreermaat met nonius en merkstrepen bij 399 en 503 mm gemerkt: 50 NED: KAN., en een L-vormige kalibreermaat met hefboommechaniek en merkstreep bij 147 mm (zonder nonius) met opschrift: 5 NED: KAN.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "Alle onderdelen zijn genummerd \"11\" (ook de kist) en dragen een stempeltje van de Nederlandse Leeuw als ijkmerk van het Ministerie van Binnenlandse Zaken.  N.B.: 1 kan = 1 liter  De oude kaart geeft een gedetailleerde beschrijving.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "J.M. KLEMAN & ZOON AMSTERDAM."
    }
