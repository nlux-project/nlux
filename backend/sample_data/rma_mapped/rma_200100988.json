              "type": "LinguisticObject",
              "content": "Jan Toorop (1858-1928), olieverf op doek, 1899"
            },
            {
              "id": "_:b16",
              "type": "Name",
              "content": "Misty Sea",
              "classified_as": [
                {
                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                },
                {
                  "id": "http://vocab.getty.edu/aat/300404670",
