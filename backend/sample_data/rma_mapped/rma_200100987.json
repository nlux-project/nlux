        },
        {
          "type": "LinguisticObject",
          "content": "In the seventeenth century, highlights in life were preferably commemorated with gold and silver objects. This gold cutlery celebrates the marriage of Amsterdam burghers Anna Roelofs de Vrij (1589-1626) and Jacob Jacobs Bicker (1581-1626). Anna received this gift from her groom in 1608. It was cherished in the family circle and passed down from generation to generation.",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300048722",
              "type": "Type"
            }
          ]
        }
